# Same Supabase project as cardstash.ar — safe to share, RLS-constrained
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SHG's own scoped-role token — NOT cardstash.ar's SUPABASE_SERVICE_ROLE_KEY.
# Minted once (see supabase/migrations/002_shg_scoped_role.sql) by signing a
# JWT with the Supabase project's JWT secret, payload { "role": "shg_service" }.
SHG_SERVICE_ROLE_JWT=

# SHG's own Resend account/sending domain
RESEND_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Separate random 32+ byte secrets — openssl rand -base64 32
SESSION_SECRET=
ADMIN_SESSION_SECRET=
